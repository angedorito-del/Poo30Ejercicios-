import java.util.Scanner;

public class Main {

    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        int opcion;

        do {
            System.out.println("\n==========================================================================");
            System.out.println("          MENÚ DE EJERCICIOS - JERARQUÍA DE OPERADORES EN JAVA            ");
            System.out.println("==========================================================================");
            System.out.println("--- BLOQUE 1: Operaciones Aritméticas Básicas ---");
            System.out.println("  1. Cálculo de Promedio Ponderado             <( )");
            System.out.println("  2. Conversión Térmica Compleja                 | " );
            System.out.println("  3. Expresión Algebraica Cuadrática            /|\\");
            System.out.println("  4. Área de un Trapecio");
            System.out.println("  5. Cálculo de Energía Cinética");
            System.out.println("  6. Desglose de Segundos a Minutos");
            System.out.println("  7. Interés Compuesto Simple (2 Periodos)");
            System.out.println("  8. Ecuación Aritmética Jerarquizada");
            System.out.println("  9. Perímetro y Área de Rectángulo");
            System.out.println(" 10. Polinomio de Segundo Grado");
            System.out.println("--- BLOQUE 2: Operadores Relacionales y Comparaciones ---");
            System.out.println(" 11. Verificación de Mayoría de Edad");
            System.out.println(" 12. Comprobación de Número Par");
            System.out.println(" 13. Comprobación de Múltiplo de 5");
            System.out.println(" 14. Comparación Estricta de Desigualdad");
            System.out.println(" 15. Discriminante de Ecuación Cuadrática");
            System.out.println(" 16. Evaluación de Límite de Crédito");
            System.out.println(" 17. Comparación de Producto vs Suma");
            System.out.println(" 18. Verificación de Cero Exacto");
            System.out.println(" 19. Diferencia Mínima Centenaria");
            System.out.println(" 20. Evaluación de Calificación Deficiente");
            System.out.println("--- BLOQUE 3: Operadores Lógicos Combinados ---");
            System.out.println(" 21. Pertenencia a Rango Cerrado [10, 50]");
            System.out.println(" 22. Exclusión de Rango (Fuera de Límites)");
            System.out.println(" 23. Condición Básica de Año Bisiesto");
            System.out.println(" 24. Propiedad de Triángulo Válido");
            System.out.println(" 25. Aprobación por Calificación y Asistencia");
            System.out.println(" 26. Criterio de Descuento Promocional");
            System.out.println(" 27. Número Par Positivo");
            System.out.println(" 28. Verificación de Rangos Extremos");
            System.out.println(" 29. Autenticación por Credenciales Numéricas");
            System.out.println(" 30. Condición Combinada Final");
            System.out.println("--------------------------------------------------------------------------");
            System.out.println("  0. Salir");
            System.out.println("==========================================================================");
            System.out.print("Seleccione el número del ejercicio que desea ejecutar (0-30): ");
            opcion = teclado.nextInt();
            System.out.println();

            switch (opcion) {
                case 1: {
                    System.out.println("--- Ejercicio 1: Cálculo de Promedio Ponderado ---");
                    double n1, n2, n3;
                    double promedioPonderado;

                    System.out.print("Ingrese la calificación 1 (20%): ");
                    n1 = teclado.nextDouble();
                    System.out.print("Ingrese la calificación 2 (30%): ");
                    n2 = teclado.nextDouble();
                    System.out.print("Ingrese la calificación 3 (50%): ");
                    n3 = teclado.nextDouble();

                    promedioPonderado = (n1 * 0.20) + (n2 * 0.30) + (n3 * 0.50);

                    System.out.println("El promedio ponderado final es: " + promedioPonderado);
                    break;
                }
                case 2: {
                    System.out.println("--- Ejercicio 2: Conversión Térmica Compleja ---");
                    double c;
                    double fahrenheit;

                    System.out.print("Ingrese la temperatura en grados Celsius: ");
                    c = teclado.nextDouble();

                    fahrenheit = (c * 9.0 / 5.0) + 32.0;

                    System.out.println("La temperatura en grados Fahrenheit es: " + fahrenheit);
                    break;
                }
                case 3: {
                    System.out.println("--- Ejercicio 3: Expresión Algebraica Cuadrática ---");
                    double x, y;
                    double resultado;

                    System.out.print("Ingrese el valor de x: ");
                    x = teclado.nextDouble();
                    System.out.print("Ingrese el valor de y: ");
                    y = teclado.nextDouble();

                    resultado = ((x * x) + (2.0 * x * y) + (y * y)) / (x + y);

                    System.out.println("El resultado de ((x^2 + 2xy + y^2) / (x + y)) es: " + resultado);
                    break;
                }
                case 4: {
                    System.out.println("--- Ejercicio 4: Área de un Trapecio ---");
                    double bMayor, bMenor, h;
                    double area;

                    System.out.print("Ingrese la Base Mayor (bMayor): ");
                    bMayor = teclado.nextDouble();
                    System.out.print("Ingrese la Base Menor (bMenor): ");
                    bMenor = teclado.nextDouble();
                    System.out.print("Ingrese la Altura (h): ");
                    h = teclado.nextDouble();

                    area = ((bMayor + bMenor) * h) / 2.0;

                    System.out.println("El área final del trapecio es: " + area);
                    break;
                }
                case 5: {
                    System.out.println("--- Ejercicio 5: Cálculo de Energía Cinética ---");
                    double m, v;
                    double energiaCinetica;

                    System.out.print("Ingrese la masa del objeto (m): ");
                    m = teclado.nextDouble();
                    System.out.print("Ingrese la velocidad del objeto (v): ");
                    v = teclado.nextDouble();

                    energiaCinetica = 0.5 * m * (v * v);

                    System.out.println("La energía cinética calculada es: " + energiaCinetica);
                    break;
                }
                case 6: {
                    System.out.println("--- Ejercicio 6: Desglose de Segundos a Minutos ---");
                    int segundosTotales;
                    int minutosCompletos, segundosSobrantes;

                    System.out.print("Ingrese la cantidad total de segundos (entero): ");
                    segundosTotales = teclado.nextInt();

                    minutosCompletos = segundosTotales / 60;
                    segundosSobrantes = segundosTotales % 60;

                    System.out.println("Minutos completos: " + minutosCompletos);
                    System.out.println("Segundos sobrantes: " + segundosSobrantes);
                    break;
                }
                case 7: {
                    System.out.println("--- Ejercicio 7: Interés Compuesto Simple (2 Periodos) ---");
                    double c, i;
                    double montoAcumulado;

                    System.out.print("Ingrese el capital inicial (c): ");
                    c = teclado.nextDouble();
                    System.out.print("Ingrese la tasa de interés en decimal (i, ej. 0.05): ");
                    i = teclado.nextDouble();

                    montoAcumulado = c * (1.0 + i) * (1.0 + i);

                    System.out.println("El monto acumulado tras 2 periodos es: " + montoAcumulado);
                    break;
                }
                case 8: {
                    System.out.println("--- Ejercicio 8: Ecuación Aritmética Jerarquizada ---");
                    int a, b, c;
                    int resultado;

                    System.out.print("Ingrese el número entero a: ");
                    a = teclado.nextInt();
                    System.out.print("Ingrese el número entero b: ");
                    b = teclado.nextInt();
                    System.out.print("Ingrese el número entero c: ");
                    c = teclado.nextInt();

                    resultado = a + (b * c) - (a / b) + (b % c);

                    System.out.println("Resultado de a + (b * c) - (a / b) + (b % c): " + resultado);
                    break;
                }
                case 9: {
                    System.out.println("--- Ejercicio 9: Perímetro y Área de Rectángulo ---");
                    double b, h;
                    double perimetro, area;

                    System.out.print("Ingrese la base del rectángulo (b): ");
                    b = teclado.nextDouble();
                    System.out.print("Ingrese la altura del rectángulo (h): ");
                    h = teclado.nextDouble();

                    perimetro = 2.0 * (b + h);
                    area = b * h;

                    System.out.println("Perímetro del rectángulo: " + perimetro);
                    System.out.println("Área del rectángulo: " + area);
                    break;
                }
                case 10: {
                    System.out.println("--- Ejercicio 10: Polinomio de Segundo Grado ---");
                    double a, b, c, x;
                    double resultadoPolinomio;

                    System.out.print("Ingrese el coeficiente a: ");
                    a = teclado.nextDouble();
                    System.out.print("Ingrese el coeficiente b: ");
                    b = teclado.nextDouble();
                    System.out.print("Ingrese el coeficiente c: ");
                    c = teclado.nextDouble();
                    System.out.print("Ingrese el valor de x: ");
                    x = teclado.nextDouble();

                    resultadoPolinomio = (a * (x * x)) + (b * x) + c;

                    System.out.println("El resultado de a*x^2 + b*x + c es: " + resultadoPolinomio);
                    break;
                }
                case 11: {
                    System.out.println("--- Ejercicio 11: Verificación de Mayoría de Edad ---");
                    int edad;
                    boolean esMayorDeEdad;

                    System.out.print("Ingrese la edad del usuario: ");
                    edad = teclado.nextInt();

                    esMayorDeEdad = edad >= 18;

                    System.out.println("¿Tiene 18 años o más?: " + esMayorDeEdad);
                    break;
                }
                case 12: {
                    System.out.println("--- Ejercicio 12: Comprobación de Número Par ---");
                    int numero;
                    boolean esPar;

                    System.out.print("Ingrese un número entero: ");
                    numero = teclado.nextInt();

                    esPar = (numero % 2) == 0;

                    System.out.println("¿El número es par?: " + esPar);
                    break;
                }
                case 13: {
                    System.out.println("--- Ejercicio 13: Comprobación de Múltiplo de 5 ---");
                    int numero;
                    boolean esMultiploDe5;

                    System.out.print("Ingrese un valor entero: ");
                    numero = teclado.nextInt();

                    esMultiploDe5 = (numero % 5) == 0;

                    System.out.println("¿Es múltiplo exacto de 5?: " + esMultiploDe5);
                    break;
                }
                case 14: {
                    System.out.println("--- Ejercicio 14: Comparación Estricta de Desigualdad ---");
                    double val1, val2;
                    boolean sonDistintos;

                    System.out.print("Ingrese el primer número decimal (val1): ");
                    val1 = teclado.nextDouble();
                    System.out.print("Ingrese el segundo número decimal (val2): ");
                    val2 = teclado.nextDouble();

                    sonDistintos = val1 != val2;

                    System.out.println("¿Ambos valores son completamente distintos?: " + sonDistintos);
                    break;
                }
                case 15: {
                    System.out.println("--- Ejercicio 15: Discriminante de Ecuación Cuadrática ---");
                    double a, b, c;
                    double discriminante;
                    boolean discriminanteValido;

                    System.out.print("Ingrese el valor de a: ");
                    a = teclado.nextDouble();
                    System.out.print("Ingrese el valor de b: ");
                    b = teclado.nextDouble();
                    System.out.print("Ingrese el valor de c: ");
                    c = teclado.nextDouble();

                    discriminante = (b * b) - (4.0 * a * c);
                    discriminanteValido = discriminante >= 0.0;

                    System.out.println("Valor del discriminante (b^2 - 4ac): " + discriminante);
                    System.out.println("¿El discriminante es mayor o igual a cero?: " + discriminanteValido);
                    break;
                }
                case 16: {
                    System.out.println("--- Ejercicio 16: Evaluación de Límite de Crédito ---");
                    double montoCompra, limiteCredito;
                    boolean excedeLimite;

                    System.out.print("Ingrese el monto total de la compra: ");
                    montoCompra = teclado.nextDouble();
                    System.out.print("Ingrese el límite de crédito disponible: ");
                    limiteCredito = teclado.nextDouble();

                    excedeLimite = montoCompra > limiteCredito;

                    System.out.println("¿El precio de la compra excede estrictamente el límite?: " + excedeLimite);
                    break;
                }
                case 17: {
                    System.out.println("--- Ejercicio 17: Comparación de Producto vs Suma ---");
                    double a, b;
                    boolean productoMenorQueSuma;

                    System.out.print("Ingrese el número a: ");
                    a = teclado.nextDouble();
                    System.out.print("Ingrese el número b: ");
                    b = teclado.nextDouble();

                    productoMenorQueSuma = (a * b) < (a + b);

                    System.out.println("¿La multiplicación (a * b) es menor que la suma (a + b)?: " + productoMenorQueSuma);
                    break;
                }
                case 18: {
                    System.out.println("--- Ejercicio 18: Verificación de Cero Exacto ---");
                    double x;
                    boolean esCeroExacto;

                    System.out.print("Ingrese un valor para x: ");
                    x = teclado.nextDouble();

                    esCeroExacto = (3.0 * x - 12.0) == 0.0;

                    System.out.println("¿La expresión 3*x - 12 es exactamente igual a cero?: " + esCeroExacto);
                    break;
                }
                case 19: {
                    System.out.println("--- Ejercicio 19: Diferencia Mínima Centenaria ---");
                    int n1, n2;
                    boolean alcanzaOSupera100;

                    System.out.print("Ingrese el primer número entero (n1): ");
                    n1 = teclado.nextInt();
                    System.out.print("Ingrese el segundo número entero (n2): ");
                    n2 = teclado.nextInt();

                    alcanzaOSupera100 = (n1 - n2) >= 100;

                    System.out.println("¿La resta (n1 - n2) alcanza o supera 100?: " + alcanzaOSupera100);
                    break;
                }
                case 20: {
                    System.out.println("--- Ejercicio 20: Evaluación de Calificación Deficiente ---");
                    double promedio;
                    boolean esDeficiente;

                    System.out.print("Ingrese la calificación promedio del alumno: ");
                    promedio = teclado.nextDouble();

                    esDeficiente = promedio < 6.0;

                    System.out.println("¿Se encuentra por debajo de la nota mínima aprobatoria (6.0)?: " + esDeficiente);
                    break;
                }
                case 21: {
                    System.out.println("--- Ejercicio 21: Pertenencia a Rango Cerrado [10, 50] ---");
                    double n;
                    boolean perteneceAlRango;

                    System.out.print("Ingrese un número (n): ");
                    n = teclado.nextDouble();

                    perteneceAlRango = (n >= 10.0) && (n <= 50.0);

                    System.out.println("¿El número pertenece al rango cerrado [10, 50]?: " + perteneceAlRango);
                    break;
                }
                case 22: {
                    System.out.println("--- Ejercicio 22: Exclusión de Rango (Fuera de Límites) ---");
                    double x;
                    boolean fueraDeRango;

                    System.out.print("Ingrese un valor (x): ");
                    x = teclado.nextDouble();

                    fueraDeRango = (x < 0.0) || (x > 100.0);

                    System.out.println("¿El número está fuera del rango de 0 a 100?: " + fueraDeRango);
                    break;
                }
                case 23: {
                    System.out.println("--- Ejercicio 23: Condición Básica de Año Bisiesto ---");
                    int anio;
                    boolean esBisiesto;

                    System.out.print("Ingrese un año (anio): ");
                    anio = teclado.nextInt();

                    esBisiesto = ((anio % 4) == 0) && !((anio % 100) == 0);

                    System.out.println("¿Es divisible por 4 y NO divisible por 100?: " + esBisiesto);
                    break;
                }
                case 24: {
                    System.out.println("--- Ejercicio 24: Propiedad de Triángulo Válido ---");
                    double a, b, c;
                    boolean esTrianguloValido;

                    System.out.print("Ingrese la longitud del lado a: ");
                    a = teclado.nextDouble();
                    System.out.print("Ingrese la longitud del lado b: ");
                    b = teclado.nextDouble();
                    System.out.print("Ingrese la longitud del lado c: ");
                    c = teclado.nextDouble();

                    esTrianguloValido = ((a + b) > c) && ((a + c) > b) && ((b + c) > a);

                    System.out.println("¿Los lados forman un triángulo válido?: " + esTrianguloValido);
                    break;
                }
                case 25: {
                    System.out.println("--- Ejercicio 25: Aprobación por Calificación y Asistencia ---");
                    double notaFinal, asistencia;
                    boolean aprueba;

                    System.out.print("Ingrese la nota final del alumno: ");
                    notaFinal = teclado.nextDouble();
                    System.out.print("Ingrese el porcentaje de asistencia (0-100): ");
                    asistencia = teclado.nextDouble();

                    aprueba = (notaFinal >= 70.0) && (asistencia >= 80.0);

                    System.out.println("¿El alumno aprueba el curso?: " + aprueba);
                    break;
                }
                case 26: {
                    System.out.println("--- Ejercicio 26: Criterio de Descuento Promocional ---");
                    int edad;
                    double montoCompra;
                    boolean obtieneDescuento;

                    System.out.print("Ingrese la edad del cliente: ");
                    edad = teclado.nextInt();
                    System.out.print("Ingrese el monto de la compra: ");
                    montoCompra = teclado.nextDouble();

                    obtieneDescuento = (edad >= 60) || (montoCompra > 1000.0);

                    System.out.println("¿El cliente obtiene el descuento promocional?: " + obtieneDescuento);
                    break;
                }
                case 27: {
                    System.out.println("--- Ejercicio 27: Número Par Positivo ---");
                    int num;
                    boolean esParPositivo;

                    System.out.print("Ingrese un número entero (num): ");
                    num = teclado.nextInt();

                    esParPositivo = (num > 0) && ((num % 2) == 0);

                    System.out.println("¿El número es positivo y par?: " + esParPositivo);
                    break;
                }
                case 28: {
                    System.out.println("--- Ejercicio 28: Verificación de Rangos Extremos ---");
                    int v;
                    boolean enRangosExtremos;

                    System.out.print("Ingrese un número entero (v): ");
                    v = teclado.nextInt();

                    enRangosExtremos = ((v >= 1) && (v <= 10)) || ((v >= 90) && (v <= 100));

                    System.out.println("¿Pertenece a [1, 10] o a [90, 100]?: " + enRangosExtremos);
                    break;
                }
                case 29: {
                    System.out.println("--- Ejercicio 29: Autenticación por Credenciales Numéricas ---");
                    int id, nip;
                    boolean credencialesValidas;

                    System.out.print("Ingrese el identificador de usuario (id): ");
                    id = teclado.nextInt();
                    System.out.print("Ingrese el código (nip): ");
                    nip = teclado.nextInt();

                    credencialesValidas = (id == 1234) && (nip == 9999);

                    System.out.println("¿Autenticación exitosa?: " + credencialesValidas);
                    break;
                }
                case 30: {
                    System.out.println("--- Ejercicio 30: Condición Combinada Final ---");
                    double a, b, c;
                    double promedio;
                    boolean cumpleCondicion;

                    System.out.print("Ingrese el número a: ");
                    a = teclado.nextDouble();
                    System.out.print("Ingrese el número b: ");
                    b = teclado.nextDouble();
                    System.out.print("Ingrese el número c: ");
                    c = teclado.nextDouble();

                    promedio = (a + b + c) / 3.0;
                    cumpleCondicion = (promedio > 50.0) && ((a == 0.0) || (b == 0.0) || (c == 0.0));

                    System.out.println("Promedio calculado: " + promedio);
                    System.out.println("¿Promedio > 50 Y al menos un valor es igual a cero?: " + cumpleCondicion);
                    break;
                }
                case 0:
                    System.out.println("Saliendo del programa...");
                    break;
                default:
                    System.out.println("Opción no válida. Por favor seleccione un número entre 0 y 30.");
                    break;
            }
        } while (opcion != 0);

        teclado.close();
    }
}
